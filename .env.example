# Copie este arquivo para .env.local e preencha com os dados do SEU
# projeto Supabase (Project Settings > API no painel do Supabase).
# NUNCA commite o .env.local — ele já está no .gitignore.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" — usada APENAS em src/lib/supabase/admin.ts,
# para criar usuários (Admin API). NUNCA prefixar com NEXT_PUBLIC_,
# nunca importar admin.ts fora de Server Actions. Ver
# docs/SUPABASE_SETUP.md antes de mexer nisso.
SUPABASE_SERVICE_ROLE_KEY=

# Chave da API do Google (Gemini), usada pelo Assistente IA (Etapa 11).
# Nunca prefixar com NEXT_PUBLIC_ — só é lida no servidor
# (src/app/api/assistente/chat/route.ts). Ver docs/ASSISTENTE_IA_SETUP.md.
GEMINI_API_KEY=
